uniform sampler2D inputTex;
uniform sampler2D tex;
uniform float mixAmt;
uniform bool maskMode;

vec4 main() {
  vec4 base = texture(inputTex, uv);
  vec4 mask = texture(tex, uv);
  float maskValue = maskMode ? dot(mask.rgb, vec3(0.299, 0.587, 0.114)) : mask.a;
  float amount = clamp(1.0 + mixAmt * 0.01, 0.0, 1.0);
  float resultAlpha = mix(base.a, base.a * maskValue, amount);
  return vec4(base.rgb * resultAlpha, resultAlpha);
}
