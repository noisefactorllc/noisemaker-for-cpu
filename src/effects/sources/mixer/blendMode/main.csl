uniform sampler2D inputTex;
uniform sampler2D tex;
uniform int mode;
uniform float mixAmt;

float overlayChannel(float base, float blend) {
  return base < 0.5 ? 2.0 * base * blend : 1.0 - 2.0 * (1.0 - base) * (1.0 - blend);
}

vec3 blendColors(vec3 base, vec3 blend) {
  if (mode == 0) return base + blend;
  if (mode == 1) return vec3(1.0) - (vec3(1.0) - base) / max(blend, vec3(0.0001));
  if (mode == 2) return min(base, blend);
  if (mode == 3) return abs(base - blend);
  if (mode == 4) return base / max(vec3(1.0) - blend, vec3(0.0001));
  if (mode == 5) return base + blend - 2.0 * base * blend;
  if (mode == 7) return max(base, blend);
  if (mode == 8) return mix(base, blend, 0.5);
  if (mode == 9) return base * blend;
  if (mode == 10) return vec3(1.0) - abs(vec3(1.0) - base - blend);
  if (mode == 11 || mode == 6) return vec3(overlayChannel(base.r, blend.r), overlayChannel(base.g, blend.g), overlayChannel(base.b, blend.b));
  if (mode == 12) return min(base, blend) - max(base, blend) + vec3(1.0);
  if (mode == 13) return vec3(1.0) - (vec3(1.0) - base) * (vec3(1.0) - blend);
  if (mode == 14) return mix(base, overlayChannel(base.r, blend.r) * vec3(1.0), 0.5);
  if (mode == 15) return base - blend;
  return blend;
}

vec4 main() {
  vec4 base = texture(inputTex, uv);
  vec4 blend = texture(tex, uv);
  vec3 result = blendColors(base.rgb, blend.rgb);
  float amount = clamp(1.0 + mixAmt * 0.01, 0.0, 1.0);
  return vec4(mix(base.rgb, result, amount), mix(base.a, blend.a, amount));
}
