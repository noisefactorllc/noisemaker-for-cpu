uniform sampler2D inputTex;
uniform float amount;
uniform float alpha;

float luma(vec2 coord) {
  return dot(texture(inputTex, coord).rgb, vec3(0.299, 0.587, 0.114));
}

vec4 main() {
  vec2 t = vec2(1.0) / resolution;
  float gx = -luma(uv + vec2(-t.x, -t.y)) - 2.0 * luma(uv + vec2(-t.x, 0.0)) - luma(uv + vec2(-t.x, t.y));
  gx += luma(uv + vec2(t.x, -t.y)) + 2.0 * luma(uv + vec2(t.x, 0.0)) + luma(uv + vec2(t.x, t.y));
  float gy = -luma(uv + vec2(-t.x, -t.y)) - 2.0 * luma(uv + vec2(0.0, -t.y)) - luma(uv + vec2(t.x, -t.y));
  gy += luma(uv + vec2(-t.x, t.y)) + 2.0 * luma(uv + vec2(0.0, t.y)) + luma(uv + vec2(t.x, t.y));
  float edge = length(vec2(gx, gy)) * amount;
  return vec4(vec3(edge), alpha);
}
