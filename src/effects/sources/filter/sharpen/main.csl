uniform sampler2D inputTex;
uniform float amount;

vec4 main() {
  vec2 texel = vec2(1.0) / resolution;
  vec4 center = texture(inputTex, uv);
  vec4 neighbors = texture(inputTex, uv + vec2(texel.x, 0.0)) + texture(inputTex, uv - vec2(texel.x, 0.0));
  neighbors += texture(inputTex, uv + vec2(0.0, texel.y)) + texture(inputTex, uv - vec2(0.0, texel.y));
  vec4 sharpened = center * (1.0 + 4.0 * amount) - neighbors * amount;
  return vec4(sharpened.rgb, center.a);
}
