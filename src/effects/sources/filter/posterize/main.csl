uniform sampler2D inputTex;
uniform int levels;
uniform float gamma;
uniform bool antialias;

vec4 main() {
  vec4 color = texture(inputTex, uv);
  vec3 corrected = pow(max(color.rgb, 0.0), vec3(gamma));
  float count = float(levels - 1);
  vec3 quantized = floor(corrected * count + 0.5) / count;
  quantized = pow(max(quantized, 0.0), vec3(1.0 / gamma));
  return vec4(quantized, color.a);
}
