uniform int loopAOffset;
uniform int loopBOffset;
uniform float loopAScale;
uniform float loopBScale;
uniform int speedA;
uniform int speedB;
uniform int seed;
uniform bool wrap;

float shapeDistance(vec2 p, int shape) {
  vec2 q = abs(p);
  if (shape == 10) return length(p);
  if (shape == 20) return max(q.y, q.x * 0.8660254 + p.y * 0.5);
  if (shape == 30) return q.x + q.y;
  if (shape == 60) return max(q.x * 0.8660254 + q.y * 0.5, q.y);
  if (shape == 400) return abs(length(p) - 0.3);
  if (shape == 410) return abs(sin(p.x * 6.2831853) - p.y);
  return max(q.x, q.y);
}

float band(vec2 p, int shape, float shapeScale, float phase) {
  float distance = shapeDistance(p * shapeScale, shape);
  return sin(distance * 12.0 - phase) * 0.5 + 0.5;
}

vec4 main() {
  vec2 p = uv - 0.5;
  p.x *= resolution.x / resolution.y;
  if (wrap) p = fract(p + 0.5) - 0.5;
  float a = band(p, loopAOffset, loopAScale, time * float(speedA) * 0.1 + float(seed));
  float b = band(p, loopBOffset, loopBScale, time * float(speedB) * 0.1 + float(seed) * 0.37);
  return vec4(a, b, (a + b) * 0.5, 1.0);
}
